# Copia este archivo como .env y completa tus datos.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Proveedor de IA: groq (gratis), gemini u ollama (local)
PROVEEDOR=groq
GROQ_API_KEY=tu-key-aqui
# GEMINI_API_KEY=tu-key-aqui

ASISTENTE_NOMBRE=Lorian
# MODELO=   (opcional: deja vacío para usar el modelo por defecto del proveedor)

# Opcional: voz con Fish Audio
# FISH_API_KEY=
# VOZ_ID=

# Opcional: para que el clima y las noticias sean de tu zona
CIUDAD=
PAIS=CL
